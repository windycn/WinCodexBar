<Window x:Class="CodexBarWin.WinUI.QualityCheckWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WinCodexBar 模型质量检测">
    <Window.SystemBackdrop><MicaBackdrop Kind="BaseAlt"/></Window.SystemBackdrop>
    <Grid Padding="24" RowSpacing="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Text="模型质量检测" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Text="用同一题目比较账号和模型，结果会保存在本机。" Opacity="0.76"/>
            </StackPanel>
            <Button Grid.Column="1" Content="关闭检测窗口" Click="CloseClicked" VerticalAlignment="Center"/>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="370"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ScrollViewer x:Name="ComposerScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14">
                    <Border CornerRadius="16" Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="检测设置" FontSize="20" FontWeight="SemiBold"/>
                            <ComboBox x:Name="AccountCombo" Header="本次使用的账号" HorizontalAlignment="Stretch" PlaceholderText="请选择账号"/>
                            <ComboBox x:Name="ModelCombo" Header="文本模型" HorizontalAlignment="Stretch" SelectedIndex="0">
                                <ComboBoxItem Content="GPT 6 Luna" Tag="gpt-6-luna"/>
                                <ComboBoxItem Content="GPT 6 Sol" Tag="gpt-6-sol"/>
                                <ComboBoxItem Content="GPT 6 Astra" Tag="gpt-6-astra"/>
                                <ComboBoxItem Content="GPT 5.6 Sol" Tag="gpt-5.6-sol"/>
                                <ComboBoxItem Content="GPT 5.6 Terra" Tag="gpt-5.6-terra"/>
                                <ComboBoxItem Content="GPT 5.6 Luna" Tag="gpt-5.6-luna"/>
                            </ComboBox>
                            <ComboBox x:Name="EffortCombo" Header="思考强度" HorizontalAlignment="Stretch" SelectedIndex="1">
                                <ComboBoxItem Content="低" Tag="low"/><ComboBoxItem Content="中" Tag="medium"/>
                                <ComboBoxItem Content="高" Tag="high"/><ComboBoxItem Content="更高" Tag="xhigh"/>
                                <ComboBoxItem Content="最大" Tag="max"/>
                            </ComboBox>
                            <ComboBox x:Name="PresetCombo" Header="检测题目预设" HorizontalAlignment="Stretch" SelectionChanged="PresetChanged"/>
                            <TextBox x:Name="PromptBox" Header="检测题目" AcceptsReturn="True" TextWrapping="Wrap" Height="180"
                                Text="创建一个完整的 HTML 文件，用 SVG 绘制鹈鹕骑自行车的 2D 动画。所有 CSS 和 JavaScript 都写在文件中，不使用外部资源。"/>
                            <Button Content="兼容输入法编辑" Click="EditPromptWithNativeImeClicked" HorizontalAlignment="Left"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="保存为我的预设" Click="SavePresetClicked"/>
                                <Button Content="删除我的预设" Click="DeletePresetClicked"/>
                            </StackPanel>
                            <Button x:Name="StartButton" Content="开始检测" Click="StartClicked" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch"/>
                            <Button x:Name="CancelButton" Content="停止检测" Click="CancelClicked" Visibility="Collapsed" HorizontalAlignment="Stretch"/>
                            <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                    <InfoBar IsOpen="True" Severity="Informational" Title="如何看结果" Message="检测会消耗所选账号额度。保留原始 HTML、生成耗时和输出 Token；单次结果不能证明模型降级。"/>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="230"/></Grid.RowDefinitions>
                <Border CornerRadius="16" Padding="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <TextBlock x:Name="EmptyPreview" Text="选择一条检测记录，在这里查看生成的 HTML 动画。" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                        <WebView2 x:Name="PreviewWebView" Visibility="Collapsed"/>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="检测记录" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <ComboBox x:Name="PeriodCombo" Grid.Column="1" SelectedIndex="0" SelectionChanged="PeriodChanged">
                        <ComboBoxItem Content="全部时间" Tag="all"/><ComboBoxItem Content="最近 7 天" Tag="7d"/><ComboBoxItem Content="今天" Tag="today"/>
                    </ComboBox>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button Content="导出 HTML" Click="ExportClicked"/>
                        <Button Content="删除记录" Click="DeleteClicked"/>
                    </StackPanel>
                </Grid>
                <ListView x:Name="HistoryList" Grid.Row="2" SelectionChanged="HistoryChanged" HorizontalContentAlignment="Stretch">
                    <ListView.ItemTemplate><DataTemplate>
                        <Border Margin="0,0,0,6" Padding="10" CornerRadius="9" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Prompt}" FontSize="12" Opacity="0.68" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border></DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="2" Text="检测窗口已就绪 · 尚未发起请求" Opacity="0.7" TextWrapping="Wrap"/>
    </Grid>
</Window>
