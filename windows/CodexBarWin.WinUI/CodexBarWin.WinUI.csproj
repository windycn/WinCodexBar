<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Platforms>x64;x86;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <AssemblyName>WinCodexBar.Next</AssemblyName>
    <RootNamespace>CodexBarWin.WinUI</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationIcon>..\CodexBarWin\Assets\Icons\WinCodexBar.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodexBarCore\CodexBarCore.csproj" />
    <ProjectReference Include="..\CodexBarImeHost\CodexBarImeHost.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="WinUIEx" Version="2.9.3" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.11" />
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\CodexBarWin\Assets\Icons\WinCodexBar.ico" Link="Assets\WinCodexBar.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\CodexBarWin\Assets\Icons\app.png" Link="Assets\app.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
