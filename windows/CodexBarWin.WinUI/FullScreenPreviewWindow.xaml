<Window x:Class="CodexBarWin.WinUI.FullScreenPreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WinCodexBar 全屏预览">
    <Grid x:Name="PreviewRoot" Background="#101827" IsTabStop="True" KeyDown="PreviewKeyDown">
        <Image x:Name="PreviewImage" Stretch="Uniform" Margin="18,70,18,18"/>
        <WebView2 x:Name="SvgPreviewWebView" Visibility="Collapsed" Margin="18,70,18,18" KeyDown="PreviewKeyDown"/>
        <Border Background="#D91B2738" CornerRadius="12" Padding="16,10"
                Margin="18" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PreviewTitle" FontSize="18" FontWeight="SemiBold"
                           Foreground="White" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Esc 退出" Foreground="#C7D7EC" VerticalAlignment="Center"/>
                <Button x:Name="ExitButton" Grid.Column="2" Content="退出全屏" Click="ExitClicked"/>
            </Grid>
        </Border>
    </Grid>
</Window>
