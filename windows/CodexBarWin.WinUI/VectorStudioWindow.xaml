<Window x:Class="CodexBarWin.WinUI.VectorStudioWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WinCodexBar 转可编辑SVG">
    <Window.SystemBackdrop><MicaBackdrop Kind="BaseAlt"/></Window.SystemBackdrop>
    <Grid Padding="24" RowSpacing="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Text="转可编辑SVG" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Text="从生图图库选择，或导入、粘贴本机图片；转换结果单独保存在 SVG 图库。" Opacity="0.76" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" Content="关闭窗口" Click="CloseClicked" VerticalAlignment="Center"/>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="370"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14">
                    <Border CornerRadius="16" Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="图片来源" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SourceText" Text="尚未选择图片" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="上传图片" Click="ImportClicked"/>
                                <Button Content="粘贴图片" Click="PasteClicked"/>
                            </StackPanel>
                            <TextBlock Text="支持 PNG、JPG 和 WebP；导入后可在生图图库中再次选择。" FontSize="12" Opacity="0.72" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="16" Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="转换设置" FontSize="20" FontWeight="SemiBold"/>
                            <ComboBox x:Name="AccountCombo" Header="本次使用的 Codex 账号" HorizontalAlignment="Stretch" PlaceholderText="请选择账号"/>
                            <ComboBox x:Name="ModelCombo" Header="转换模型" HorizontalAlignment="Stretch" SelectedIndex="0">
                                <ComboBoxItem Content="GPT 6 Luna" Tag="gpt-6-luna"/><ComboBoxItem Content="GPT 6 Sol" Tag="gpt-6-sol"/><ComboBoxItem Content="GPT 6 Astra" Tag="gpt-6-astra"/>
                                <ComboBoxItem Content="GPT 5.6 Luna" Tag="gpt-5.6-luna"/><ComboBoxItem Content="GPT 5.6 Terra" Tag="gpt-5.6-terra"/><ComboBoxItem Content="GPT 5.6 Sol" Tag="gpt-5.6-sol"/>
                            </ComboBox>
                            <ComboBox x:Name="EffortCombo" Header="思考强度" HorizontalAlignment="Stretch" SelectedIndex="0">
                                <ComboBoxItem Content="轻度" Tag="low"/><ComboBoxItem Content="中等" Tag="medium"/><ComboBoxItem Content="高度" Tag="high"/>
                                <ComboBoxItem Content="更高" Tag="xhigh"/><ComboBoxItem Content="最大" Tag="max"/>
                            </ComboBox>
                            <TextBlock Text="复杂图片使用更强的模型，通常能更准确地重绘轮廓和细节；结果仍可能需要手动调整。" FontSize="12" Opacity="0.72" TextWrapping="Wrap"/>
                            <TextBox x:Name="GuidanceBox" Header="补充要求（可选）" PlaceholderText="例如：保留文字轮廓，简化背景" AcceptsReturn="True" TextWrapping="Wrap" Height="82"/>
                            <Button Content="兼容输入法编辑" Click="EditGuidanceWithNativeImeClicked" HorizontalAlignment="Left"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="ConvertButton" Content="转换所选图片" Click="ConvertClicked" Style="{ThemeResource AccentButtonStyle}"/>
                                <Button x:Name="CancelButton" Content="取消转换" Click="CancelClicked" Visibility="Collapsed"/>
                            </StackPanel>
                            <ProgressBar x:Name="ConversionProgress" IsIndeterminate="True" Visibility="Collapsed"/>
                            <TextBlock Text="任务队列 · 最多同时运行 6 项" FontWeight="SemiBold"/>
                            <ListView x:Name="CreativeQueueList" Height="112" SelectionMode="None">
                                <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/></DataTemplate></ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="16" Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="SVG 图库存储" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="GalleryPathText" TextWrapping="Wrap" FontSize="12" Opacity="0.78"/>
                            <Button Content="更改 SVG 图库目录" Click="ChangeGalleryPathClicked" HorizontalAlignment="Left"/>
                            <TextBlock Text="SVG 与 metadata 索引分开存放；失配文件自动移到 trash。" TextWrapping="Wrap" FontSize="12" Opacity="0.72"/>
                            <ComboBox x:Name="TrashRetentionCombo" Header="清理回收站" SelectedIndex="1" HorizontalAlignment="Stretch" SelectionChanged="TrashRetentionChanged">
                                <ComboBoxItem Content="全部清理" Tag="0"/><ComboBoxItem Content="超过 1 周" Tag="7"/>
                                <ComboBoxItem Content="超过 1 个月" Tag="30"/><ComboBoxItem Content="超过 3 个月" Tag="90"/>
                                <ComboBoxItem Content="自定义天数" Tag="custom"/>
                            </ComboBox>
                            <NumberBox x:Name="CustomTrashDays" Header="超过多少天" Minimum="1" Maximum="3650" Value="14" Visibility="Collapsed"/>
                            <Button Content="清理 SVG 回收站" Click="CleanTrashClicked" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Column="1" RowSpacing="10">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="265"/></Grid.RowDefinitions>
                <Border CornerRadius="16" Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <TextBlock x:Name="EmptyPreview" Text="选择一张图片或 SVG 后在这里预览" FontSize="18" Opacity="0.72" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed" DoubleTapped="PreviewDoubleTapped"/>
                        <WebView2 x:Name="SvgPreviewWebView" Visibility="Collapsed"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="取消选择" Click="ClearSelectionClicked"/>
                    <Button Content="全屏预览" Click="FullScreenClicked"/>
                    <Button Content="打开 SVG" Click="OpenSvgClicked"/>
                    <Button Content="复制 SVG 代码" Click="CopySvgClicked"/>
                    <Button Content="打开 SVG 图库" Click="OpenVectorGalleryClicked"/>
                    <Button Content="删除选中 SVG" Click="DeleteSvgClicked"/>
                </StackPanel>
                <Pivot Grid.Row="2">
                    <PivotItem Header="生图与导入图片">
                        <GridView x:Name="SourceList" SelectionMode="Multiple" SelectionChanged="SourceSelectionChanged">
                            <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid ItemWidth="172" ItemHeight="205"/></ItemsPanelTemplate></GridView.ItemsPanel>
                            <GridView.ItemTemplate><DataTemplate>
                                <Border Width="164" Height="195" Padding="7" CornerRadius="9" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="4">
                                        <Border CornerRadius="6" Height="106" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"><Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/></Border>
                                        <TextBlock Text="{Binding Prompt}" MaxLines="2" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="{Binding CreatedLabel}" Opacity="0.68" FontSize="11"/>
                                        <TextBlock Text="{Binding ModelLabel}" Opacity="0.76" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate></GridView.ItemTemplate>
                        </GridView>
                    </PivotItem>
                    <PivotItem Header="SVG 图库">
                        <GridView x:Name="VectorList" SelectionChanged="VectorSelectionChanged">
                            <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid ItemWidth="208" ItemHeight="235"/></ItemsPanelTemplate></GridView.ItemsPanel>
                            <GridView.ItemTemplate><DataTemplate>
                                <Border Width="200" Height="225" Padding="8" CornerRadius="9" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="4">
                                        <Border CornerRadius="6" Height="110" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"><Image Source="{Binding Thumbnail}" Stretch="Uniform"/></Border>
                                        <TextBlock Text="{Binding Prompt}" MaxLines="1" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="{Binding CreatedLabel}" Opacity="0.68" FontSize="12"/>
                                        <TextBlock Text="{Binding ModelLabel}" Opacity="0.76" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding MetricsLabel}" Opacity="0.76" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate></GridView.ItemTemplate>
                        </GridView>
                    </PivotItem>
                </Pivot>
            </Grid>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="2" Text="选择图片后开始转换。" Opacity="0.76" TextWrapping="Wrap"/>
    </Grid>
</Window>
